; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Beating Up"
run/main_scene="uid://frd0uluithcc"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/max_fps=120
config/icon="res://icon.svg"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
EventBus="*res://Core/EventBus/event_bus.gd"
InputReader="*res://Core/Inputs/input_reader.gd"
CompositionRoot="*res://Core/Bootstrap/composition_root.gd"
PhysicsService="*res://Services/Physics/physics_service.gd"
RenderService="*res://Services/Rendering/render_service.gd"
AnimationService="*res://Services/Rendering/animation_service.gd"
AudioService="*res://Services/Audio/audio_service.gd"
PauseController="*res://Controllers/pause_controller.gd"
UiController="*res://Controllers/ui_controller.gd"

[dialogic]

directories/dch_directory={
"unit_test_character": "res://Tests/Resources/unit_test_character.dch"
}
directories/dtl_directory={}
layout/style_directory={}

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/dialogic/plugin.cfg")

